TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=1753566525
TELEGRAM_ENABLE_POLLING=true
TELEGRAM_CHANNEL_URL=
TELEGRAM_WEBHOOK_SECRET=
SERVER_PORT=8787
ADMIN_WEB_TOKEN=
PUBLIC_APP_URL=

# Supabase PostgreSQL. Leave empty for local JSON storage.
# Prefer Supabase's Session Pooler connection string, or Direct connection if your network supports it.
DATABASE_URL=
PGSSLMODE=require
DATABASE_SSL=true
DATABASE_POOL_MAX=3

# Supabase Storage S3. Leave empty for local file storage.
OBJECT_STORAGE_BUCKET=face-candidate-media
OBJECT_STORAGE_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=ap-southeast-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
