TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=1753566525
# The hosted service is webhook-only. This legacy value must stay false.
TELEGRAM_ENABLE_POLLING=false
TELEGRAM_CHANNEL_URL=
TELEGRAM_WEBHOOK_SECRET=
# Railway injects PORT. SERVER_PORT is only a local fallback.
SERVER_PORT=8787
ADMIN_WEB_TOKEN=
ADMIN_WEB_ID=super_admin
ADMIN_WEB_NAME=Super Admin
PUBLIC_APP_URL=

# Supabase PostgreSQL. Railway production requires this to be set.
# Prefer Supabase's Session Pooler connection string, or Direct connection if your network supports it.
DATABASE_URL=
PGSSLMODE=require
DATABASE_SSL=true
DATABASE_POOL_MAX=3

# Supabase Storage S3. Railway production requires all of these to be set.
OBJECT_STORAGE_BUCKET=face-candidate-media
OBJECT_STORAGE_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=ap-southeast-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
