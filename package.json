{
  "name": "face-production-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "examples:prepare": "node scripts/prepare-example-media.js",
    "examples:upload": "node scripts/upload-example-media.js",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "build": "node --check server/index.js && node --check api/index.js && node --check vercel/handler.js",
    "check:supabase": "node scripts/check-supabase.js",
    "check:vercel": "node scripts/check-vercel-readiness.js",
    "lint": "eslint .",
    "migrate:postgres": "node scripts/migrate-json-to-postgres.js",
    "normalize:taxonomy": "node scripts/normalize-candidate-taxonomy.js",
    "test:messaging": "node --test test/messaging-logic.test.js",
    "test:profile-management": "node --test test/profile-management.test.js test/profile-api.test.js",
    "test:performance": "node --test test/performance-contract.test.js",
    "test:castings-management": "node --import ./test/helpers/register-casting-outbox-loader.mjs --test test/castings-api.test.js test/casting-publication-outbox.test.js test/casting-lifecycle-reliability.test.js",
    "test:ui": "node --test test/castings-ui.test.js",
    "test:telegram": "node --test test/messaging-logic.test.js test/message-lifecycle.test.js test/example-delivery.test.js test/example-media.test.js test/candidate-messaging-policy.test.js test/candidate-decision-messages.test.js test/casting-messages.test.js test/casting-bot-flow.test.js test/telegram-example-repository.test.js",
    "test:persistence-safety": "node scripts/test-persistence-safety.js",
    "webhook:delete": "node scripts/delete-telegram-webhook.js",
    "webhook:set": "node scripts/set-telegram-webhook.js"
  },
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0"
  }
}
