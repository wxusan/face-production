{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'FACE portal is served by Railway through Vercel proxy routing.'",
  "regions": ["bom1"],
  "routes": [
    {
      "src": "/api/(?<path>.*)",
      "dest": "/api/proxy?path=$path"
    },
    {
      "src": "/(.*)",
      "dest": "https://face-production-staging.up.railway.app/$1"
    }
  ]
}
