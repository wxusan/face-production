{
  "name": "@face-production/dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "bot": "node server/bot.js",
    "server": "node server/index.js",
    "server:poll": "TELEGRAM_ENABLE_POLLING=true node server/index.js",
    "build": "node --check server/index.js && node --check server/bot.js && node --check api/index.js && node --check vercel/handler.js",
    "check:supabase": "node scripts/check-supabase.js",
    "check:vercel": "node scripts/check-vercel-readiness.js",
    "lint": "eslint .",
    "migrate:postgres": "node scripts/migrate-json-to-postgres.js",
    "normalize:taxonomy": "node scripts/normalize-candidate-taxonomy.js",
    "webhook:delete": "node scripts/delete-telegram-webhook.js",
    "webhook:set": "node scripts/set-telegram-webhook.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0"
  }
}
